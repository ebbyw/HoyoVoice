# personal casting/config (created from voices.example.json).
# The .bak glob matters: a backup of this file carries the same
# personal casting, player_name and device names, and an untracked
# one is exactly what `git add -A` sweeps into a commit.
voices.json
voices.json.bak*

# voice packs added from the dashboard (someone else's model weights)
voices_custom/

# environments & caches
# the trailing slash matches a directory only, and a worktree under
# .claude/worktrees/ borrows the venv as a SYMLINK — which the slash form
# lets straight into `git add -A`
.venv/
.venv
__pycache__/
*.pyc
.DS_Store

# runtime artifacts (frames, audio, session state, logs)
captures/
tts_out/
recordings/
*.log
unknown_speakers.log
nohup.out

# built by setup.sh
tools/ocrd
tools/silero_vad.onnx

# downloaded by setup.ps1 (Kokoro ONNX model + voices)
models/

# launcher state
hoyovoice.pid

# historical planning docs (kept locally, not tracked)
archive/

# anchor template PNGs are crops of the games' own chrome and never ship:
# the app self-calibrates them into captures/anchors/ from the user's own
# capture, and `anchors.py extract` output here stays local too
tools/profiles/anchors/*/*.png

# Claude Code worktrees and local session state
.claude/worktrees/
.claude/settings.local.json

# agent-facing notes (local, not part of the published project)
CLAUDE.md
AGENTS.md

# OCR benchmark corpora: frames are game screenshots, and large
bench/

# sweep_frames.py output: per-frame OCR block dumps are the games' own
# text — same reason as bench/
corpus/
before.json
after.json
