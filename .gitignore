# personal casting/config (created from voices.example.json)
voices.json

# voice packs added from the dashboard (someone else's model weights)
voices_custom/

# environments & caches
# the trailing slash matches a directory only, and a worktree under
# .claude/worktrees/ borrows the venv as a SYMLINK — which the slash form
# lets straight into `git add -A`
.venv/
.venv
__pycache__/
*.pyc
.DS_Store

# runtime artifacts (frames, audio, session state, logs)
captures/
tts_out/
recordings/
*.log
unknown_speakers.log
nohup.out

# built by setup.sh
tools/ocrd
tools/silero_vad.onnx

# downloaded by setup.ps1 (Kokoro ONNX model + voices)
models/

# launcher state
hoyovoice.pid

# historical planning docs (kept locally, not tracked)
archive/

# Claude Code worktrees and local session state
.claude/worktrees/

# agent-facing notes (local, not part of the published project)
CLAUDE.md
AGENTS.md

# OCR benchmark corpora: frames are game screenshots, and large
bench/
